                                <a class="vendor-image" href="/collections/vendors?q={{ product_card_product.vendor }}" title="{{ product_card_product.vendor }}">
                                    <img src="{{ vendor_img | file_url }}" alt="{{ product_card_product.vendor }}">
                                </a>
                            {%- else -%}
                                {{ product_card_product.vendor | link_to_vendor: class: 'vendor-text' }}
                            {%- endif -%}
                        </div>
                    {% unless settings.disable_product_card_border and settings.enable_custom_layout_card %}    
                    </div>
                    {% endunless %}
                {%- endif -%}
               
                <a class="card-title link-underline{% if settings.product_title_line_text != 'full' %} card-title-ellipsis{% endif %}{% if variant_selected != blank %} card-title-change{% endif %}" href="{{ product_url_with_collection }}" data-product-title="{{ product_card_product.title | escape }}" data-product-url="{{ product_url_with_collection }}">
                    <span class="text">
                        {{ product_card_product.title | escape }}
                        {% if variant_selected != blank %}
                            <span data-change-title> {% if settings.style_text_color_varriant == '01' %}-{% endif %} {{ variant_selected }}</span>
                        {% endif %}
                    </span>
                </a>

                {% if settings.disable_product_card_border and settings.enable_custom_layout_card %}
                    </div>
                {% endif %}

